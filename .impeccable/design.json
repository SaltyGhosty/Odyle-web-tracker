  "narrative": {
    "northStar": "Engaste de orbes",
    "overview": "An orb is a jewel and the page is its setting. The most urgent character sits on a stage: a 3D orb of liquid light inside a ring of 56 Atreia runes, closed by a thin gold (Luz) or violet (Sombra) hairline circle. Beside it a case holds the other characters as round-cornered tiles, over a living sky of slow gold and blue light. Both themes are dark and mid-tone; crimson is shared and means someone is at cap.",
    "keyCharacteristics": [
      "Two faction themes via data-faction; every colour is a token including --sky-1..3.",
      "Rounded cards (18px) with 10px controls; 1px lines only as meaningful hairlines.",
      "Marcellus for names and headings, Gothic A1 tabular for everything operated or counted.",
      "One-line top bar with three clocks, then stage plus case.",
      "Slow, optional motion: living sky, refill pulse, entrances, floating tile orbs."
    ],
    "rules": [
      {
        "name": "The Crimson-Means-Cap Rule",
        "body": "Crimson appears only for a character at cap or for destructive and error states. Never decoration, never an accent.",
        "section": "colors"
      },
      {
        "name": "The Token-Only Rule",
        "body": "A component reads a variable; it never writes a colour, so both factions stay in step. The sky reads `--sky-1..3` and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Tone-Not-Line Rule",
        "body": "Separate cards by stepping the ground (sky, bar, card, field); a line is allowed only as a hairline that carries meaning.",
        "section": "colors"
      },
      {
        "name": "The Name-In-Marcellus Rule",
        "body": "A proper name (character, event, heading) is Marcellus; every number, button and helper is Gothic A1.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every counting number is tabular.",
        "section": "typography"
      },
      {
        "name": "The Inset-Ring Rule",
        "body": "Marking a card (reset, active, selected, full) is an inset ring, 1px for a standing fact, 2px for a state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do read every colour from a variable and check both `data-faction` themes.",
      "Do use 18px for top-level cards, 14px for cards inside them, 10px for controls.",
      "Do mark a card state with an inset ring, not an outer shadow.",
      "Do keep names in Marcellus and numbers, buttons and helpers in Gothic A1 tabular.",
      "Do gate any new motion behind `prefers-reduced-motion` and `body.calm`, and start it from an event, not from the per-second repaint.",
      "Do keep tap targets at 44px and clock text unclipped at 390px."
    ],
    "donts": [
      "Don't use crimson for anything that is not at-cap or destructive.",
      "Don't add drop shadows, backdrop blur or glass; stack tone instead.",
      "Don't put text directly on the sky; text lives on a card.",
      "Don't return to a white Elyos or to square corners on cards.",
      "Don't replace the authored line icons with glyph characters or an icon set.",
      "Don't copy the official Aion 2 script, NCSOFT art or Elder Futhark runes into the ring; the 28 glyphs are original.",
      "Don't set a display face other than Marcellus for names or headings."
    ]
  }
}